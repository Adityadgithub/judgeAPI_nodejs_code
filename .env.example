PORT=3000
NODE_ENV=development

# Self-hosted Judge0 CE server
JUDGE0_URL=http://YOUR_SERVER_IP:2358

# Request and Judge0 polling behavior
REQUEST_TIMEOUT_MS=30000
POLL_INTERVAL_MS=1000
MAX_POLL_ATTEMPTS=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Use * for development, or set your frontend origin in production
CORS_ORIGIN=*
